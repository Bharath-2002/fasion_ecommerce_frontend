# Used only by `npm run dev`. Production builds leave VITE_API_BASE_URL
# unset (relative fetches — see src/lib/api.js) since the deployed frontend
# and API share one host (backend repo docs/ARCHITECTURE.md, decision A1).
VITE_API_BASE_URL=http://localhost:8000

# The one tenant scripts/seed_demo_storefront.py creates locally — see
# src/lib/auth.js's docstring for why this is a demo-only shortcut, not a
# real tenant picker. Must match the backend's SOFTBOX_BOOTSTRAP_OWNER_TENANT_ID
# for the bootstrap-owner login to actually select into a tenant it belongs to.
VITE_DEMO_TENANT_ID=4fc331f5-9212-4db6-bca5-a45b55f56b1f
